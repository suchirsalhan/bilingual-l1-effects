#!/bin/bash
#
# Example SLURM job script for Wilkes3 (AMD EPYC 7763, ConnectX-6, A100)
# Last updated: Feb 2026
#

#SBATCH -J bilingual
#SBATCH -A BUTTERY-SL2-GPU
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --exclusive
#SBATCH --time=36:00:00
#SBATCH --mail-type=FAIL
#SBATCH -p ampere

numnodes=$SLURM_JOB_NUM_NODES
numtasks=$SLURM_NTASKS
mpi_tasks_per_node=$(echo "$SLURM_TASKS_PER_NODE" | sed -e  's/^\([0-9][0-9]*\).*$/\1/')

# Environment
. /etc/profile.d/modules.sh
module purge
module load rhel8/default-amp
module load python/3.11.0-icl

JOBID=$SLURM_JOB_ID
export OMP_NUM_THREADS=1
np=$[${numnodes}*${mpi_tasks_per_node}]

echo -e "JobID: $JOBID\n======"
echo "Time: `date`"
echo "Running on master node: `hostname`"
echo "Current directory: `pwd`"


nodes=( $( scontrol show hostnames $SLURM_JOB_NODELIST ) )
nodes_array=($nodes)
head_node=${nodes_array[0]}
head_node_ip=$(srun --nodes=1 --ntasks=1 -w "$head_node" hostname --ip-address)
port_number=$(shuf -i 29510-49510 -n 1)

echo Node IP: $head_node_ip
export LOGLEVEL=INFO

#! CD back to root directory
cd ..

module load python/3.11.0-icl
source demo311/bin/activate

python --version
which python
# Run training on the specified language
# Pass all extra arguments if needed
LANG=$1
shift  # remove first argument from $@ so $@ contains only extra args

torchrun \
    --nnodes=1 \
    --nproc-per-node=4 \
    --rdzv-backend=c10d \
    --rdzv-endpoint=localhost:0 \
    bilingual/train.py --lang "$LANG" "$@"

