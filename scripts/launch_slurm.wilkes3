#!/bin/bash
#
# SLURM job script for Wilkes3 — 5B-token streaming GPT-2 LM
# AMD EPYC 7763, ConnectX-6, A100
# Last updated: Feb 2026
#

#SBATCH -J bilingual
#SBATCH -A BUTTERY-SL2-GPU
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --exclusive
#SBATCH --time=36:00:00
#SBATCH --mail-type=FAIL
#SBATCH -p ampere

# ---------------- Environment ----------------
. /etc/profile.d/modules.sh
module purge
module load rhel8/default-amp
module load python/3.11.0-icl

JOBID=$SLURM_JOB_ID
echo -e "JobID: $JOBID\n======"
echo "Time: $(date)"
echo "Running on master node: $(hostname)"
echo "Current directory: $(pwd)"

# Activate Python environment
source demo311/bin/activate
python --version
which python

# ---------------- Distributed config ----------------
numnodes=$SLURM_JOB_NUM_NODES
numtasks=$SLURM_NTASKS
mpi_tasks_per_node=$(echo "$SLURM_TASKS_PER_NODE" | sed -e  's/^\([0-9][0-9]*\).*$/\1/')

nodes=( $( scontrol show hostnames $SLURM_JOB_NODELIST ) )
head_node=${nodes[0]}
head_node_ip=$(srun --nodes=1 --ntasks=1 -w "$head_node" hostname --ip-address)

# Random port for rendezvous
port_number=$(shuf -i 29510-49510 -n 1)
export MASTER_ADDR=$head_node_ip
export MASTER_PORT=$port_number
export LOGLEVEL=INFO
export NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_DEBUG=INFO
export OMP_NUM_THREADS=1

# ---------------- Training ----------------
LANG=$1
shift  # remove first argument so $@ contains extra arguments

torchrun \
    --nnodes=$numnodes \
    --nproc-per-node=4 \
    --rdzv-backend=c10d \
    --rdzv-endpoint=$MASTER_ADDR:$MASTER_PORT \
    --rdzv-conf="join_timeout=7200,rdzv_timeout=7200,factory_max_retries=1" \
    bilingual/train.py --lang "$LANG" "$@"
