def tokenize_with_padding(texts, max_length=512):
    """
    Tokenize and pad everything to max_length.
    Shorter sequences get padding tokens added.
    Longer sequences get truncated.
    """
    return tokenizer(
        texts,
        truncation=True,
        max_length=max_length,
        padding='max_length',
        return_tensors='pt'
    )

