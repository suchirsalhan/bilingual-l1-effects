def create_labels(input_ids, pad_token_id=50256):
    """
    Create training labels by shifting input right by 1.
    This is the core of causal language modeling.
    """
    labels = input_ids.clone()

    # Remove first token, add padding at end
    labels = torch.cat([
        labels[:, 1:],
        torch.full((labels.shape[0], 1), pad_token_id)
    ], dim=1)

    return labels

