def prepare_labels(labels, pad_token_id=50256):
    """
    Replace padding tokens with -100 (except the first one).

    Why? PyTorch's CrossEntropyLoss ignores -100 labels.
    This means the model doesn't waste time learning to predict padding.
    """
    labels_processed = labels.clone()

    for i in range(labels.shape[0]):
        # Find all padding positions
        pad_positions = (labels[i] == pad_token_id).nonzero(as_tuple=True)[0]

        # Replace all but the first padding token
        if len(pad_positions) > 1:
            labels_processed[i, pad_positions[1:]] = -100

    return labels_processed

