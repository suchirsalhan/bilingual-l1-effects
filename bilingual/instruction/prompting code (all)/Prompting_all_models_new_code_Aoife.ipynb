    {
      "cell_type": "code",
      "source": [
        "from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline, GenerationConfig\n",
        "import torch"
      ],
      "metadata": {
        "id": "SRSQz0S4Nsky"
      },
